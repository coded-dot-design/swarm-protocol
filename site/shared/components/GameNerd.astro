---
import UiIcon from './UiIcon.astro';
import Icon from './AbstractIcon.astro';
// Full engineering notes for one game: its own page, linked from the game page.
const { game, index = 0, base = '/' } = Astro.props;
const repo = `https://github.com/coded-dot-design/${game.id}`;
const kb = (n) => (n / 1000).toFixed(1);
---
<section id={`${game.id}-nerd`} class:list={['game-section', 'standalone', 'nerd-page', `accent-${game.accent}`]} aria-labelledby={`${game.id}-nerd-title`}>
  <a class="back-link" href={`${base}games/${game.id}/`} data-virus-ignore data-swarm-ignore><UiIcon name="arrow-up-right" size={16} class="back-arrow"/> {game.name}</a>
  <div class="section-heading"><span class="eyebrow"><span class="index">0{index + 1}</span> NERD NOTES / {game.kind}</span><span class="version">v{game.version} / MIT</span></div>
  <div class="nerd-intro">
    <div class="nerd-badge" aria-hidden="true"><Icon kind={game.icon} size={64}/></div>
    <div><h2 id={`${game.id}-nerd-title`}>How {game.name}<span>works under the hood.</span></h2><p class="lead">{game.engine}</p></div>
  </div>
  <div class="game-facts"><div><b>{kb(game.metrics.gzip)}<small> kB</small></b><span>gzip · {game.id === 'swarm-protocol' ? 'full immediate path' : 'complete game + engine'}</span></div><div><b>{kb(game.metrics.raw)}<small> kB</small></b><span>minified JavaScript</span></div>{game.facts.slice(0, 2).map((f) => <div><b>{f.value}</b><span>{f.label}</span></div>)}</div>
  <div class="nerd-chapters">{game.chapters.map((chapter, i) => <article><span class="eyebrow">0{i + 1}</span><h3>{chapter.title}</h3><p>{chapter.body}</p></article>)}</div>
  {game.extra && <p class="nerd-extra">{game.extra}</p>}
  <div class="nerd-sources" data-virus-ignore data-swarm-ignore><span class="eyebrow">READ THE SOURCE</span><div class="source-links">{game.sourcePaths.map((path) => <a href={`${repo}/blob/main/${path}`}>{path} <UiIcon name="arrow-up-right" size={15}/></a>)}</div></div>
  <div class="nerd-actions" data-virus-ignore data-swarm-ignore><a class="button primary" href={`${base}games/${game.id}/`}><UiIcon name="play" size={18}/> Back to {game.name}</a><a class="button quiet" href={`${base}under-the-hood/`}>Engine-wide notes <UiIcon name="arrow-up-right" size={18}/></a></div>
</section>
