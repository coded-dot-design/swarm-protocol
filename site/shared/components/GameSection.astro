---
import Icon from './AbstractIcon.astro';
import UiIcon from './UiIcon.astro';
import CharacterIcon from './Icon.astro';
import battlefieldIcon from '../assets/battlefield-icon.svg?raw';
const { game, index = 0, single = false } = Astro.props;
const repo=`https://github.com/coded-dot-design/${game.id}`;
const kb=(n)=> (n/1000).toFixed(1);
const enemy = ({ship:"ship",runner:"fly-chaser",bug:"bug",tank:"tank"})[game.icon];
// Control lines read "Keys — action · Keys — action". Keys become keycaps; plain-language
// inputs (touch D-pad, edge alerts) stay text chips. "Label: a · b" lines become chip rows.
const CAP = /^(?:[A-Z0-9]|Space|Esc|Enter|Shift|Tab|Click|Mouse|tap|Tap|Scroll)$/;
const keyToken = (t) => {
  t = t.trim();
  if (/^wasd$/i.test(t)) return { cluster: ['W', 'A', 'S', 'D'] };
  if (/^arrows$/i.test(t)) return { cluster: ['↑', '←', '↓', '→'] };
  if (/^(mouse|click|click \/ tap|tap)$/i.test(t)) return { mouse: t.replace(/^./, (c) => c.toUpperCase()) };
  if (CAP.test(t)) return { key: t };
  return { text: t };
};
const parseControl = (line) => {
  const label = line.match(/^([^—:]+):\s*(.+)$/);
  if (label && !line.includes(' — ')) return { label: label[1], chips: label[2].split(' · ') };
  return {
    pairs: line.split(/ · |;\s+(?=[^;]*\s—\s)/).map((part) => {
      const [keys, ...rest] = part.split(' — ');
      return { keys: keys.split(/\s+\/\s+/).map(keyToken), action: rest.join(' — ') };
    }),
  };
};
const controls = game.controls.map(parseControl);
---
<section id={game.id} class:list={['game-section', `accent-${game.accent}`]} aria-labelledby={`${game.id}-title`}>
  <div class="section-heading"><span class="eyebrow"><span class="index">0{index+1}</span> {game.kind}</span><span class="version">v{game.version} / MIT</span></div>
  <div class="game-intro">
    <div><h2 id={`${game.id}-title`}>{game.name}<span>{game.tagline}</span></h2><p class="lead">{game.description}</p><div class="actions" data-virus-ignore data-swarm-ignore><button class="button primary" data-launch={game.id}><UiIcon name="play" size={18}/> Play {game.name}</button>{game.id === "sherman-bytes" && <a class="button quiet battlefield-link" href="https://coded-dot-design.github.io/dom-virus/battlefield/"><Fragment set:html={battlefieldIcon}/> Open Battlefield</a>}<a class="button quiet" href={`${repo}#readme`}>Read the source <UiIcon name="arrow-up-right" size={18}/></a></div>{game.archives?.length > 0 && <div class="release-picker" data-virus-ignore data-swarm-ignore><label for={`${game.id}-release`}>TEST A RELEASE</label><select id={`${game.id}-release`} data-release={game.id}><option value={game.id} data-version={`v${game.version}`}>Current · v{game.version}</option>{game.archives.map(release=><option value={release.key} data-version={release.version}>{release.version} · archived</option>)}</select><p>Play uses the selected build. Notes below describe the current release.</p></div>}<p class="credit">Created by <span>Chris Cooley</span> · coded.design</p></div>
    <div data-byte-obstacle class="game-display" data-cartridge={game.id} aria-label={`${game.name} gameplay illustration`}>
      <div class="display-top"><span class="led"></span> {game.kind}<span class="display-note">DOM / ACTIVE SURFACE</span></div>
      <div class="arena-copy"><span class="arena-line">THE PAGE IS</span><span class="arena-line">THE PLAYFIELD<span class="blinking-dot">.</span></span></div>
      <div class="demo-path"><i></i><i></i><i></i><i></i><i></i><i></i></div>
      <div class="arena-character"><Icon kind={game.icon} size={76}/></div>
      <div class="arena-enemy one"><Icon kind={enemy} size={34}/></div><div class="arena-enemy two"><Icon kind={game.icon === "runner" ? "fly-interceptor" : enemy} size={28}/></div><div class="arena-targets"><button data-arcade-target data-virus-target data-swarm-target>SPAWN_01</button><button data-arcade-target data-virus-target data-swarm-target>SPAWN_02</button></div>
      <div class="display-bottom"><span>{game.versionNote}</span><span>ARCADE SIGNALS / DOM TERRAIN</span></div>
    </div>
  </div>
  {game.id === "sherman-bytes" && <aside data-sherman-wall>HARD COVER / Drive around this bunker. Shells stop here.</aside>}
  <div class="game-facts"><div><b>{kb(game.metrics.gzip)}<small> kB</small></b><span>gzip · {game.id === 'swarm-protocol' ? 'full immediate path' : 'complete game + engine'}</span></div>{game.facts.map(f=><div><b>{f.value}</b><span>{f.label}</span></div>)}</div>
  {game.characters?.length > 0 && <div class="character-guide"><div class="eyebrow">MEET THE CHARACTERS</div><h3>Know who’s on the page.</h3><ul>{game.characters.map(character=><li><div data-byte-obstacle class="character-portrait"><CharacterIcon kind={character.icon} size={48} color={character.color || undefined}/></div><div><span class="eyebrow">{character.role}</span><h4>{character.name}</h4><p>{character.rules}</p></div></li>)}</ul></div>}
  <div class="game-bottom">
    <div class="game-loop"><div class="eyebrow">THE LOOP</div><ol>{game.loop.map((step,i)=><li><span>0{i+1}</span>{step}</li>)}</ol><div class="controls" data-virus-ignore data-swarm-ignore><h3>Know your controls.</h3><ul class="keymap">{controls.map(c=>c.pairs ? <li>{c.pairs.map(p=><span class="key-pair"><span class="keys">{p.keys.map((k,i)=><>{i>0 && <i class="key-or">/</i>}{k.cluster ? <span class={`key-cluster${k.cluster[0]==='W'?' wasd':''}`} aria-label={k.cluster.join(' ')}>{k.cluster.map(c=><kbd class="keycap">{c}</kbd>)}</span> : k.mouse ? <kbd class="keycap mouse" aria-label={k.mouse}><svg viewBox="0 0 16 22" aria-hidden="true"><rect x="1.5" y="1.5" width="13" height="19" rx="6.5"/><path d="M8 1.5v6M1.5 8h13"/></svg><small>{k.mouse}</small></kbd> : k.key ? <kbd class={`keycap${k.key.length>1?' wide':''}`}>{k.key}</kbd> : <span class="key-chip">{k.text}</span>}</>)}</span>{p.action && <span class="key-action">{p.action}</span>}</span>)}</li> : <li class="key-row-label"><span class="key-label">{c.label}</span>{c.chips.map(x=><span class="key-chip">{x}</span>)}</li>)}</ul><p class="control-note">Sound starts after your first input. Minimize keeps the game running; Recall restores the page.</p></div></div>
    <div class="game-notes">{game.chapters.slice(0,2).map(chapter=><article><h3>{chapter.title}</h3><p>{chapter.body}</p></article>)}<details><summary data-virus-ignore data-swarm-ignore>Open the engineering notes <UiIcon name="chevron-down" class="disclosure-icon"/></summary><div>{game.chapters.slice(2).map(chapter=><article><h3>{chapter.title}</h3><p>{chapter.body}</p></article>)}<p>{game.extra}</p><div class="source-links" data-virus-ignore data-swarm-ignore>{game.sourcePaths.map(path=><a href={`${repo}/blob/main/${path}`}>{path} <UiIcon name="arrow-up-right" size={15}/></a>)}</div></div></details></div>
  </div>
  {game.palette?.length > 0 && <footer class="game-palette" aria-label={`${game.name} color palette`} data-virus-ignore data-swarm-ignore><div class="eyebrow">GAME PALETTE / FULL SIGNAL</div><div class="palette-bar">{game.palette.map(swatch=><div class="palette-swatch"><i style={`--swatch:${swatch.color}`} aria-hidden="true"></i><span>{swatch.label}<code>{swatch.color}</code></span></div>)}</div></footer>}
</section>
