{
  "name": "@chriscooley/swarm-protocol",
  "version": "1.1.0",
  "description": "A small, opt-in DOM defense game with lazy loading and optional React integration.",
  "license": "MIT",
  "author": "Chris Cooley",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./widget": {
      "types": "./dist/widget.d.ts",
      "import": "./dist/widget.js",
      "default": "./dist/widget.js"
    },
    "./package.json": "./package.json",
    "./deferred": {
      "types": "./dist/deferred.d.ts",
      "import": "./dist/deferred.js",
      "default": "./dist/deferred.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "PERFORMANCE.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "integration/SwarmProtocol.astro",
    "docs/API.md",
    "docs/DROP-IN.md"
  ],
  "sideEffects": [
    "./site-kit/**",
    "./site/**"
  ],
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "dev": "node site/shared/scripts/prepare.mjs && astro dev --config site/astro.config.mjs",
    "playground:build": "vite build --config playground/vite.config.mjs",
    "playground:preview": "vite preview --config playground/vite.config.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "prepack": "npm run check",
    "size": "node scripts/size.mjs",
    "release:build": "node scripts/build-release.mjs",
    "dev:playground": "vite --config playground/vite.config.mjs",
    "site:prepare": "node site/shared/scripts/prepare.mjs",
    "site:build": "npm run site:typecheck && node site/shared/scripts/prepare.mjs && astro build --config site/astro.config.mjs && node site/shared/scripts/verify.mjs",
    "site:preview": "astro preview --config site/astro.config.mjs",
    "site:typecheck": "tsc -p site/shared/tsconfig.json"
  },
  "keywords": [
    "game",
    "easter-egg",
    "astro",
    "react",
    "canvas",
    "dom"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "astro": "7.4.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/coded-dot-design/swarm-protocol.git"
  },
  "homepage": "https://github.com/coded-dot-design/swarm-protocol#readme",
  "bugs": {
    "url": "https://github.com/coded-dot-design/swarm-protocol/issues"
  }
}
