---
import Icon from './AbstractIcon.astro';
// Home-page game picker: cartridges pop up as the shelf scrolls in; picking one plugs it into
// the console (client.ts) and the console screen morphs into the game page (View Transitions).
const { games, base = '/' } = Astro.props;
---
<section class="game-directory cartridge-shelf" id="games" aria-labelledby="games-title">
  <div class="eyebrow">INSERT CURIOSITY. PRESS PLAY.</div>
  <h2 id="games-title">Pick a cartridge.</h2>
  <p class="shelf-lead">Each game plays across the page you are reading. Pick one to open its page, then press Play.</p>
  <div class="shelf" data-shelf data-virus-ignore data-swarm-ignore>
    {games.map((game, i) => (
      <a class:list={['cartridge', `accent-${game.accent}`]} href={`${base}games/${game.id}/`} data-cart={game.id} style={`--i:${i}`}>
        <span class="cart-grip" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
        <span class="cart-label">
          <span class="cart-art" aria-hidden="true"><Icon kind={game.icon} size={44}/></span>
          <small>0{i + 1} / {game.kind}</small>
          <strong>{game.name}</strong>
          <em>{game.tagline}</em>
        </span>
        <span class="cart-pins" aria-hidden="true"></span>
      </a>
    ))}
  </div>
  <div class="console" data-console aria-hidden="true">
    <div class="console-slot"><i></i></div>
    <div class="console-body">
      <div class="console-screen" data-console-screen><span class="console-boot">INSERT CARTRIDGE</span><span class="console-name"></span></div>
      <div class="console-controls"><i class="console-dpad"></i><span class="console-brand">DOM·VIRUS</span><i class="console-btn b"></i><i class="console-btn a"></i></div>
      <span class="console-led"></span>
    </div>
  </div>
</section>
