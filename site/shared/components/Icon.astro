---
const { kind = 'ship', size = 48 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true" class="character-icon">
  {kind === 'ship' && <><path d="M14 2h4v6h4v6h4v10h-8v-4h-4v4H6V14h4V8h4V2Z" fill="currentColor"/><path d="M14 10h4v8h-4z" fill="var(--surface)"/><path d="M10 26h4v4h-4zm8 0h4v4h-4z" fill="currentColor" opacity=".4"/></>}
  {kind === 'runner' && <><path d="M16 2 30 9 18 16l12 7-14 7L2 16 16 2Z" fill="currentColor"/><path d="M14 8h3v3h-3z" fill="var(--surface)"/><path d="M26 14h3v3h-3z" fill="currentColor" opacity=".4"/></>}
  {kind === 'bug' && <><path d="M10 8h12v16H10z" fill="currentColor"/><path d="m12 8-4-5m12 5 4-5M10 12 4 9m6 8H2m8 4-6 5m18-14 6-3m-6 8h8m-8 4 6 5" stroke="currentColor" stroke-width="2"/><path d="M15 10h2v12h-2z" fill="var(--surface)"/></>}
</svg>
