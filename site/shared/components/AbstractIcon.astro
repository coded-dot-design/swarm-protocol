---
import characterArt from "@character-art";
const { kind = 'ship', size = 48 } = Astro.props;

const selectedArt=characterArt[kind];
---
<svg width={size} height={size} viewBox={selectedArt?.viewBox || "0 0 32 32"} fill="none" aria-hidden="true" class="character-icon">
  {selectedArt && <g shape-rendering="crispEdges">{selectedArt.layers.map(layer=><path d={layer.d} fill={layer.fill}/>)}</g>}
  {kind === 'bug' && <g fill="currentColor" shape-rendering="crispEdges"><path d="M8 0h3v4h3v3h-3V4H8Zm16 0h-3v4h-3v3h3V4h3ZM8 12H4v-2H1v3h3v2h4Zm16 0h4v-2h3v3h-3v2h-4ZM6 18H0v3h6Zm20 0h6v3h-6ZM8 24H4v3H1v3h4v-3h3Zm16 0h4v3h3v3h-4v-3h-3Z"/><path fill-rule="evenodd" d="M12 4h8v4h4v4h2v12h-2v4h-4v2h-8v-2H8v-4H6V12h2V8h4ZM10 10v3h4v-3Zm8 0v3h4v-3Zm-3 6v10h2V16Z"/></g>}
  {kind === 'tank' && <><path d="M3 5h26v7H3zm0 16h26v7H3z" fill="currentColor" opacity="1"/><path d="M7 9h17v15H7z" fill="currentColor"/><path d="M12 12h10v9H12z" fill="var(--surface)"/><path d="M19 15h13v3H19z" fill="currentColor"/></>}
</svg>
