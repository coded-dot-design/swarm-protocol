---
import PromoCharacter from './PromoCharacter.astro';
import Character from './AbstractIcon.astro';
import UiIcon from './UiIcon.astro';
import MotionToggle from './MotionToggle.astro';
---
<div data-byte-obstacle class="hero-art hero-crossover" role="group" aria-label="A tank and interceptor defend a real page from flies, aliens and a swarm bug.">
  <div class="code-chrome"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>your.page / under attack</span><MotionToggle label="scene"/></div>
  <div class="promo-stage">
    <div class="promo-page"><div class="promo-title">HELLO,<br/><span>WORL<span class="binary">01</span></span></div><div class="promo-lines" aria-hidden="true"><i></i><i></i></div><button class="art-button promo-button" data-arcade-target data-virus-target data-swarm-target>BUTTON_01 <UiIcon name="arrow-up-right" size={14}/></button></div>
    <svg class="promo-action" viewBox="0 0 500 360" fill="none" aria-hidden="true">
      <g transform="translate(315 20) rotate(-135 52 52)"><g class="promo-motion promo-ship"><PromoCharacter kind="ship" size={104} color="#06c4ff"/></g></g>
      <g transform="translate(267 140)"><g class="promo-motion promo-fly hit-by-ship"><Character kind="fly-chaser" size={43}/></g></g>
      <g transform="translate(326 165)"><g class="promo-motion promo-fly second"><Character kind="fly-interceptor" size={32}/></g></g>
      <g transform="translate(-17 152) rotate(-12 21 21)"><g class="promo-motion promo-bug"><PromoCharacter kind="bug" size={42} color="#ff6b6b"/></g></g>
      <g transform="translate(16 279) rotate(-12 55 50)"><g class="promo-motion promo-tank"><PromoCharacter kind="tank" size={110} color="#74dfa1"/></g></g>
      <g transform="translate(338 236)"><g class="promo-motion promo-alien hit-by-tank"><PromoCharacter kind="alien" size={52} color="#b1a1e8"/></g></g>
      <g transform="translate(411 280)"><g class="promo-motion promo-alien reserve"><PromoCharacter kind="alien" size={31} color="#f4457a"/></g></g>
      <path class="promo-motion ship-shot" d="m336 109-10 10" stroke="#06c4ff" stroke-width="4"/>
      <path class="promo-motion tank-shot" d="m126 321 17-4" stroke="#74dfa1" stroke-width="5"/>
      <g transform="translate(288 161)"><g class="promo-motion ship-impact" stroke="#06c4ff" stroke-width="3"><path d="M-12-12-20-20M12-12l8-8M12 12l8 8M-12 12l-8 8"/></g></g>
      <g transform="translate(364 262)"><g class="promo-motion tank-impact" stroke="#74dfa1" stroke-width="4"><path d="M-16 0h-10M16 0h10M0-16v-10M0 16v10M-13-13l-6-6M13 13l6 6"/></g></g>
    </svg>
    <div class="promo-status"><span class="led"></span> SAME PAGE. DIFFERENT RULES.</div>
  </div>
</div>
<style>
.hero-crossover{width:calc(100% - 48px);margin:42px 24px 24px;overflow:visible;isolation:isolate;transform:rotate(-2deg)}
.hero-crossover .code-chrome{padding:9px 14px;min-height:44px}.hero-crossover .code-chrome>:nth-child(2){margin-inline:auto;font-size:9px}
.promo-stage{position:relative;aspect-ratio:500/360;container-type:inline-size}.promo-page{position:absolute;inset:0;padding:12% 10%}
.promo-title{font:700 10cqw/1.08 var(--mono);letter-spacing:-.5cqw;color:var(--ink)}.promo-title>span{color:var(--faint)}.promo-title .binary{color:var(--accent-text,var(--accent));display:inline-block;transform:rotate(-7deg)}
.promo-lines{margin-top:5%}.promo-lines i{height:1cqw;width:40%;background:var(--line);margin:1.6cqw 0}.promo-lines i:last-child{width:29%}
.hero-crossover .promo-button{position:relative;margin-top:8%;font-size:clamp(7px,2cqw,10px);min-height:30px;padding:2.4% 3.5%;gap:3cqw;z-index:2;background:var(--raised);color:var(--muted);border-color:var(--line);box-shadow:none}
.promo-action{position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none;z-index:3}.promo-status{position:absolute;bottom:14px;right:16px;display:flex;align-items:center;gap:7px;font:8px var(--mono);color:var(--faint)}
.promo-motion{animation-duration:5s;animation-iteration-count:infinite;animation-play-state:paused!important;transform-box:fill-box;transform-origin:center}.hero-crossover[data-motion="true"] .promo-motion{animation-play-state:running!important}
.promo-ship{animation-name:ship-recoil}.promo-tank{animation-name:tank-recoil}.promo-fly{animation-name:fly-dodge;animation-timing-function:steps(4)}.promo-fly.second{animation-delay:-2s}.promo-bug{animation-name:bug-skitter;animation-timing-function:steps(4)}.hit-by-ship{animation-name:fly-hit}.hit-by-tank{animation-name:alien-hit}.reserve{animation-name:alien-step;animation-timing-function:steps(3)}
.ship-shot{animation-name:ship-fire;opacity:0}.tank-shot{animation-name:tank-fire;opacity:0}.ship-impact{animation-name:ship-impact;opacity:0}.tank-impact{animation-name:tank-impact;opacity:0}
@keyframes ship-recoil{0%,18%,34%,100%{transform:translateY(0)}21%{transform:translateY(8px)}26%{transform:translateY(-3px)}}
@keyframes tank-recoil{0%,59%,76%,100%{transform:translateX(0)}62%{transform:translateX(-9px)}68%{transform:translateX(2px)}}
@keyframes ship-fire{0%,19%{opacity:0;transform:translate(0,0)}20%{opacity:1;transform:translate(0,0)}30%{opacity:1;transform:translate(-38px,42px)}31%,100%{opacity:0;transform:translate(-38px,42px)}}
@keyframes tank-fire{0%,60%{opacity:0;transform:translate(0,0)}61%{opacity:1;transform:translate(0,0)}73%{opacity:1;transform:translate(218px,-54px)}74%,100%{opacity:0;transform:translate(218px,-54px)}}
@keyframes ship-impact{0%,29%,40%,100%{opacity:0;transform:scale(.6)}31%{opacity:1;transform:scale(1)}39%{opacity:0;transform:scale(1.7)}}
@keyframes tank-impact{0%,72%,84%,100%{opacity:0;transform:scale(.6)}74%{opacity:1;transform:scale(1)}83%{opacity:0;transform:scale(1.7)}}
@keyframes fly-hit{0%,29%,44%,100%{transform:translate(0,0);opacity:1}31%,36%{transform:translate(-6px,6px) rotate(-12deg);opacity:.2}}
@keyframes alien-hit{0%,72%,89%,100%{transform:scale(1);opacity:1}74%,79%{transform:scale(.8) rotate(9deg);opacity:.25}}
@keyframes fly-dodge{0%,100%{transform:translate(0,0)}50%{transform:translate(12px,-9px)}}
@keyframes bug-skitter{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}
@keyframes alien-step{0%,100%{transform:translateX(0)}50%{transform:translateX(-10px)}}
@media(max-width:760px){.hero-crossover{max-width:470px;width:calc(100% - 40px);margin:40px auto 24px}.promo-status{font-size:6px;bottom:10px;right:10px}}
@media(prefers-reduced-motion:reduce){.hero-crossover *{animation:none!important}.ship-shot,.tank-shot,.ship-impact,.tank-impact{opacity:0}}
</style>
