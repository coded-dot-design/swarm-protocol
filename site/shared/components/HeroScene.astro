---
import PromoCharacter from './PromoCharacter.astro';
import Character from './AbstractIcon.astro';
import UiIcon from './UiIcon.astro';
import MotionToggle from './MotionToggle.astro';
/*
  Hero mash-up, CSS only. Intro (one shot): the DOM Virus skull spawns into the browser card,
  more bad guys follow, the interceptor flies in from off screen and the tank drives up from
  the bottom. Then an 8s loop: each shooter turns on its own centre (plane body / tank turret)
  to face a target, fires, and the target explodes and respawns.
  All animation is paused until the scene toggle (or visibility script) sets data-motion="true".
*/
const INTRO = 3.4, LOOP = 8, TRAVEL = 0.24, RESPAWN = 2.4;
const PLANE = { x: 404, y: 96, r: 44 };
const TANK = { x: 196, y: 298, r: 58 };
const SKULL = 'M19 6h26v6h7v6h6v6h5v22h-5v6h-8v12h-9v-8h-6v8h-8v-8h-6v8h-8V52H5v-6H0V24h5v-6h6v-6h8ZM11 29v14h15V29Zm26 0v14h15V29Z';
// Bad guys from every game; three are DOM Virus skulls. `spawn` is the intro time.
const foes = [
  { id: 'skull', art: 'skull', x: 262, y: 150, size: 58, color: '#f4457a', spawn: 0.2 },
  { id: 'alien', art: 'alien', x: 382, y: 228, size: 52, color: '#b1a1e8', spawn: 0.75, idle: 'step' },
  { id: 'fly', art: 'fly-chaser', x: 300, y: 70, size: 44, spawn: 1.0, idle: 'dodge' },
  { id: 'skull2', art: 'skull', x: 446, y: 304, size: 32, color: '#06c4ff', spawn: 1.2 },
  { id: 'alien2', art: 'alien', x: -18, y: 150, size: 44, color: '#f4457a', spawn: 1.4, idle: 'step' },
  { id: 'skull3', art: 'skull', x: 170, y: -14, size: 28, color: '#ffd166', spawn: 1.6 },
  { id: 'fly2', art: 'fly-interceptor', x: 508, y: 168, size: 38, spawn: 1.8, idle: 'dodge' },
  { id: 'bug', art: 'bug', x: -34, y: -26, size: 38, color: '#ff6b6b', spawn: 2.0, idle: 'skitter', decor: true },
];
const byId = Object.fromEntries(foes.map((f) => [f.id, f]));
// Loop schedule (seconds into the 8s loop): plane and tank alternate.
const kills = [
  { by: 'plane', t: 0.6, foe: 'skull' },
  { by: 'tank', t: 1.6, foe: 'alien' },
  { by: 'plane', t: 2.6, foe: 'alien2' },
  { by: 'tank', t: 3.6, foe: 'skull2' },
  { by: 'plane', t: 4.6, foe: 'fly2' },
  { by: 'tank', t: 5.6, foe: 'fly' },
  { by: 'plane', t: 6.6, foe: 'skull3' },
].map((k, i) => {
  const s = k.by === 'plane' ? PLANE : TANK, f = byId[k.foe];
  const a = Math.atan2(f.y - s.y, f.x - s.x);
  const mx = s.x + Math.cos(a) * s.r, my = s.y + Math.sin(a) * s.r;
  return { ...k, i, f, a, mx, my, tx: f.x - mx, ty: f.y - my, hit: k.t + TRAVEL };
});
// Near-misses: a spray shot just before most kills, a few degrees off, that streaks off screen.
const misses = kills.filter((k) => k.i !== 3).map((k) => {
  const s = k.by === 'plane' ? PLANE : TANK, a = k.a + (k.i % 2 ? -0.2 : 0.17), t = k.t - 0.18;
  const mx = s.x + Math.cos(a) * s.r, my = s.y + Math.sin(a) * s.r;
  return { by: k.by, t, a, mx, my, tx: Math.cos(a) * 650, ty: Math.sin(a) * 650 };
});
const deg = (r) => (r * 180) / Math.PI;
const pct = (t) => `${((t / LOOP) * 100).toFixed(2)}%`;
// Turn-to-target keyframes with shortest-path unwrapping; `offset` maps sprite facing to 0°.
function aimFrames(name, list, offset) {
  let prev = deg(list.at(-1).a) + offset;
  const start = prev, stops = [`0%{transform:rotate(${start.toFixed(1)}deg)}`];
  for (const k of list) {
    let next = deg(k.a) + offset;
    while (next - prev > 180) next -= 360;
    while (next - prev < -180) next += 360;
    stops.push(`${pct(k.t - 0.5)}{transform:rotate(${prev.toFixed(1)}deg)}`, `${pct(k.t - 0.12)}{transform:rotate(${next.toFixed(1)}deg)}`);
    prev = next;
  }
  stops.push(`100%{transform:rotate(${prev.toFixed(1)}deg)}`);
  return { css: `@keyframes ${name}{${stops.join('')}}`, base: start };
}
function recoilFrames(name, list, axis) {
  const stops = ['0%,100%{transform:none}'];
  for (const k of list)
    stops.push(`${pct(k.t)}{transform:none}`, `${pct(k.t + 0.05)}{transform:translate${axis}(${axis === 'Y' ? 9 : -10}px)}`, `${pct(k.t + 0.28)}{transform:none}`);
  return `@keyframes ${name}{${stops.join('')}}`;
}
const planeKills = kills.filter((k) => k.by === 'plane'), tankKills = kills.filter((k) => k.by === 'tank');
const planeAim = aimFrames('hx-plane-aim', planeKills, 90); // ship art faces up
const tankAim = aimFrames('hx-turret-aim', tankKills, 0); // barrel faces right
const shake = `@keyframes hx-shake{0%,100%{transform:none}${kills
  .map((k) => `${pct(k.hit)}{transform:none}${pct(k.hit + 0.03)}{transform:translate(-5px,3px) rotate(-.5deg)}${pct(k.hit + 0.06)}{transform:translate(4px,-3px) rotate(.4deg)}${pct(k.hit + 0.1)}{transform:none}`)
  .join('')}}`;
const css = [planeAim.css, tankAim.css, recoilFrames('hx-plane-kick', planeKills, 'Y'), recoilFrames('hx-turret-kick', tankKills, 'X'), shake].join('');
// Ten pixel shards per blast.
const shards = Array.from({ length: 10 }, (_, i) => {
  const a = (i / 10) * Math.PI * 2 + (i % 2) * 0.3, d = 48 + (i % 3) * 16;
  return { dx: Math.round(Math.cos(a) * d), dy: Math.round(Math.sin(a) * d), r: (i % 2 ? 1 : -1) * (90 + i * 25), s: 4 + (i % 3) * 2 };
});
const tones = ['#ffe14d', '#f4457a', '#06c4ff', '#fff4ff'];
const loopDelay = (t) => `animation-delay:${(INTRO + t).toFixed(2)}s`;
---
<div data-byte-obstacle class="hero-art hero-crossover" role="group" aria-label="DOM Virus skulls and bad guys from every game spawn into a browser window; a tank and an interceptor arrive and blast them.">
  <div class="code-chrome"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>your.page / under attack</span><MotionToggle label="scene"/></div>
  <div class="promo-stage promo-motion" style={`animation-delay:${INTRO}s`}>
    <div class="promo-page"><div class="promo-title">HELLO,<br/><span>WORL<span class="binary">01</span></span></div><div class="promo-lines" aria-hidden="true"><i></i><i></i></div><button class="art-button promo-button" data-arcade-target data-virus-target data-swarm-target>BUTTON_01 <UiIcon name="arrow-up-right" size={14}/></button></div>
    <svg class="promo-action" viewBox="0 0 500 360" fill="none" aria-hidden="true">
      {foes.map((f) => {
        const k = kills.find((k) => k.foe === f.id);
        return (
          <g transform={`translate(${f.x} ${f.y})`}>
            <circle class="promo-motion spawn-ring" r={f.size * 0.45} stroke={f.color || '#06c4ff'} stroke-width="3" style={`animation-delay:${f.spawn}s`}/>
            <g class="promo-motion spawn" style={`animation-delay:${f.spawn}s`}>
              <g class={k ? 'promo-motion die' : undefined} style={k ? loopDelay(k.hit) : undefined}>
                <g class={f.idle ? `promo-motion idle-${f.idle}` : undefined}>
                  <g transform={`translate(${-f.size / 2} ${-f.size / 2})`}>
                    {f.art === 'skull' ? (
                      <svg class="promo-character foe-skull" width={f.size} height={f.size} viewBox="0 0 64 64" shape-rendering="crispEdges"><path fill-rule="evenodd" d={SKULL} fill={f.color}/></svg>
                    ) : f.art === 'alien' || f.art === 'bug' ? (
                      <PromoCharacter kind={f.art} size={f.size} color={f.color}/>
                    ) : (
                      <Character kind={f.art} size={f.size}/>
                    )}
                  </g>
                </g>
              </g>
            </g>
          </g>
        );
      })}
      <g transform={`translate(${PLANE.x} ${PLANE.y})`}>
        <g class="promo-motion plane-in">
          <g class="promo-motion plane-aim" style={`transform:rotate(${planeAim.base.toFixed(1)}deg);animation-delay:${INTRO}s`}>
            <g class="promo-motion plane-kick" style={`animation-delay:${INTRO}s`}>
              <rect x="-48" y="-48" width="96" height="96" fill="none"/>
              <g transform="translate(-48 -48)"><PromoCharacter kind="ship" size={96} color="#06c4ff"/></g>
            </g>
          </g>
        </g>
      </g>
      <g transform={`translate(${TANK.x} ${TANK.y})`}>
        <g class="promo-motion tank-in">
          <g class="promo-motion tank-rumble">
            <g class="tank-hull" fill="#2f9a5e" shape-rendering="crispEdges">
              <rect x="-42" y="-36" width="84" height="20"/>
              <rect x="-42" y="16" width="84" height="20"/>
              <rect x="-30" y="-24" width="54" height="48"/>
              <path d="M-38 -30h6v8h-6zm14 0h6v8h-6zm14 0h6v8h-6zm14 0h6v8h-6zm14 0h6v8h-6zM-38 22h6v8h-6zm14 0h6v8h-6zm14 0h6v8h-6zm14 0h6v8h-6zm14 0h6v8h-6z" fill="#1d6a40"/>
            </g>
            <g class="promo-motion turret-aim" style={`transform:rotate(${tankAim.base.toFixed(1)}deg);animation-delay:${INTRO}s`}>
              <g class="promo-motion turret-kick" style={`animation-delay:${INTRO}s`}>
                <rect x="-60" y="-60" width="120" height="120" fill="none"/>
                <g shape-rendering="crispEdges">
                  <rect x="10" y="-6" width="46" height="12" fill="#5ff09a" stroke="#123d27" stroke-width="2"/>
                  <rect x="50" y="-8" width="8" height="16" fill="#123d27"/>
                  <rect x="-19" y="-18" width="38" height="36" fill="#5ff09a" stroke="#123d27" stroke-width="2"/>
                  <rect x="-9" y="-8" width="18" height="16" fill="#123d27"/>
                </g>
              </g>
            </g>
          </g>
        </g>
      </g>
      {kills.map((k) => (
        <path class="promo-motion shot" d={`M${k.mx.toFixed(1)} ${k.my.toFixed(1)}l${(Math.cos(k.a) * 18).toFixed(1)} ${(Math.sin(k.a) * 18).toFixed(1)}`} stroke={k.by === 'plane' ? '#06c4ff' : '#4bce82'} stroke-width="5" stroke-linecap="square" style={`--tx:${k.tx.toFixed(1)}px;--ty:${k.ty.toFixed(1)}px;${loopDelay(k.t)}`}/>
      ))}
      {misses.map((m) => (
        <path class="promo-motion shot miss" d={`M${m.mx.toFixed(1)} ${m.my.toFixed(1)}l${(Math.cos(m.a) * 14).toFixed(1)} ${(Math.sin(m.a) * 14).toFixed(1)}`} stroke={m.by === 'plane' ? '#7fe3ff' : '#9ff0bf'} stroke-width="4" stroke-linecap="square" style={`--tx:${m.tx.toFixed(1)}px;--ty:${m.ty.toFixed(1)}px;${loopDelay(m.t)}`}/>
      ))}
      {kills.map((k) => (
        <g transform={`translate(${k.f.x} ${k.f.y})`} class="boom" style={`--d:${(INTRO + k.hit).toFixed(2)}s`}>
          <circle class="promo-motion boom-flash" r="16" fill="#fff4ff"/>
          <circle class="promo-motion boom-core" r="12" fill="#ffe14d"/>
          <circle class="promo-motion boom-ring" r="14" stroke={k.f.color || '#06c4ff'} stroke-width="4"/>
          <rect class="promo-motion boom-ring square" x="-14" y="-14" width="28" height="28" stroke="#f4457a" stroke-width="3"/>
          {shards.map((s, j) => <rect class="promo-motion shard" x={-s.s / 2} y={-s.s / 2} width={s.s} height={s.s} fill={j % 3 === 0 ? k.f.color || '#06c4ff' : tones[j % tones.length]} style={`--dx:${s.dx}px;--dy:${s.dy}px;--r:${s.r}deg`}/>)}
        </g>
      ))}
    </svg>
    <div class="promo-status"><span class="led"></span> SAME PAGE. DIFFERENT RULES.</div>
  </div>
</div>
<style is:inline set:html={css}></style>
<style>
.hero-crossover{width:calc(100% - 48px);margin:42px 24px 24px;overflow:visible;isolation:isolate;transform:rotate(-2deg)}
.hero-crossover .code-chrome{padding:9px 14px;min-height:44px}.hero-crossover .code-chrome>:nth-child(2){margin-inline:auto;font-size:9px}
.promo-stage{position:relative;aspect-ratio:500/360;container-type:inline-size}.promo-page{position:absolute;inset:0;padding:12% 10%}
.promo-title{font:700 10cqw/1.08 var(--mono);letter-spacing:-.5cqw;color:var(--ink)}.promo-title>span{color:var(--faint)}.promo-title .binary{color:var(--accent-text,var(--accent));display:inline-block;transform:rotate(-7deg)}
.promo-lines{margin-top:5%}.promo-lines i{height:1cqw;width:40%;background:var(--line);margin:1.6cqw 0}.promo-lines i:last-child{width:29%}
.hero-crossover .promo-button{position:relative;margin-top:8%;font-size:clamp(7px,2cqw,10px);min-height:30px;padding:2.4% 3.5%;gap:3cqw;z-index:2;background:var(--raised);color:var(--muted);border-color:var(--line);box-shadow:none}
.promo-action{position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none;z-index:3}.promo-status{position:absolute;bottom:14px;right:16px;display:flex;align-items:center;gap:7px;font:8px var(--mono);color:var(--faint)}
/* Everything waits for the scene toggle; intro pieces run once, loop pieces every 8s. */
.promo-motion{animation-play-state:paused!important;transform-box:fill-box;transform-origin:center}
.hero-crossover[data-motion="true"] .promo-motion{animation-play-state:running!important}
.promo-stage{animation:hx-shake 8s infinite}
.spawn{animation:spawn .5s cubic-bezier(.3,1.6,.5,1) both}
.spawn-ring{opacity:0;animation:spawn-ring .6s ease-out both}
.plane-in{animation:plane-in 1.1s 1.6s cubic-bezier(.2,.8,.3,1) both}
.tank-in{animation:tank-in 1s 2.1s cubic-bezier(.25,1.3,.5,1) both}
.tank-rumble{animation:rumble .18s steps(2) 3.1s infinite}
.plane-aim{animation:hx-plane-aim 8s ease-in-out infinite}
.plane-kick{animation:hx-plane-kick 8s infinite}
.turret-aim{animation:hx-turret-aim 8s ease-in-out infinite}
.turret-kick{animation:hx-turret-kick 8s infinite}
.die{animation:die 8s infinite}
.idle-dodge{animation:dodge 1.4s steps(4) infinite}
.idle-step{animation:step 1.2s steps(3) infinite}
.idle-skitter{animation:skitter 1s steps(4) infinite}
.shot{opacity:0;animation:shot 8s linear infinite;transform-box:view-box;transform-origin:0 0}
.shot.miss{animation-name:miss}
@keyframes miss{0%{opacity:1;transform:translate(0,0)}6%{opacity:1}8%{opacity:0;transform:translate(var(--tx),var(--ty))}100%{opacity:0;transform:translate(var(--tx),var(--ty))}}
.boom .promo-motion{opacity:0;animation-duration:8s;animation-iteration-count:infinite;animation-delay:var(--d)}
.boom-flash{animation-name:boom-flash}.boom-core{animation-name:boom-core}.boom-ring{animation-name:boom-ring}.boom-ring.square{animation-name:boom-square}.shard{animation-name:shard;animation-timing-function:cubic-bezier(.15,.8,.3,1)}
@keyframes spawn{0%{transform:scale(0) rotate(-40deg);opacity:0}60%{transform:scale(1.3) rotate(6deg);opacity:1}100%{transform:none;opacity:1}}
@keyframes spawn-ring{0%{transform:scale(.2);opacity:0}8%{opacity:1}100%{transform:scale(2.4);opacity:0}}
@keyframes plane-in{0%{transform:translate(260px,-240px) rotate(-320deg) scale(.6);opacity:0}15%{opacity:1}100%{transform:none;opacity:1}}
@keyframes tank-in{0%{transform:translateY(230px)}100%{transform:none}}
@keyframes rumble{50%{transform:translateY(1px)}}
@keyframes shot{0%{opacity:1;transform:translate(0,0)}3%{opacity:1;transform:translate(var(--tx),var(--ty))}3.1%,100%{opacity:0;transform:translate(var(--tx),var(--ty))}}
@keyframes die{0%{transform:none;opacity:1;filter:none}.6%{transform:scale(1.45) rotate(8deg);filter:brightness(4)}2%{transform:scale(.1) rotate(-30deg);opacity:0}29%{transform:scale(.1);opacity:0;filter:none}32%{transform:scale(1.3);opacity:1}35%,100%{transform:none;opacity:1}}
@keyframes boom-flash{0%{transform:scale(.3);opacity:1}1.5%{transform:scale(3.2);opacity:1}4%,100%{transform:scale(4);opacity:0}}
@keyframes boom-core{0%{transform:scale(.4);opacity:1}2.5%{transform:scale(2.6);opacity:1}6%,100%{transform:scale(.2);opacity:0}}
@keyframes boom-ring{0%{transform:scale(.5);opacity:1}6%,100%{transform:scale(6);opacity:0}}
@keyframes boom-square{0%{transform:scale(.4) rotate(0);opacity:1}8%,100%{transform:scale(4.6) rotate(90deg);opacity:0}}
@keyframes shard{0%{transform:translate(0,0) rotate(0);opacity:1}7%{transform:translate(var(--dx),var(--dy)) rotate(var(--r));opacity:1}9%,100%{transform:translate(var(--dx),calc(var(--dy) + 14px)) rotate(var(--r));opacity:0}}
@keyframes dodge{0%,100%{transform:none}50%{transform:translate(9px,-7px)}}
@keyframes step{0%,100%{transform:none}50%{transform:translateX(-8px)}}
@keyframes skitter{0%,100%{transform:none}50%{transform:translateY(-10px)}}
@media(max-width:760px){.hero-crossover{max-width:470px;width:calc(100% - 40px);margin:40px auto 24px}.promo-status{font-size:6px;bottom:10px;right:10px}}
@media(prefers-reduced-motion:reduce){.hero-crossover *{animation:none!important}.shot,.boom .promo-motion,.spawn-ring{opacity:0}}
</style>
