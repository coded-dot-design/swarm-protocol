<!-- Copy this component into src/components and include it once in a shared layout. -->
<script>
  import {
    installSwarmDeferred,
    type SwarmDeferredInstallation,
    type SwarmInstallOptions,
  } from '@chriscooley/swarm-protocol/deferred';

  // Edit these selectors to match the exact elements on your site.
  const options: SwarmInstallOptions = {
    triggerSelector: '[data-swarm-trigger]',
    targetSelector: '[data-swarm-target]',
    textSelector: '[data-swarm-text]',
    surfaceSelector: '[data-swarm-surface]',
    storageKey: 'my-site-swarm-best-v1',
    onError: error => console.error('Swarm Protocol could not open.', error),
  };
  const scheduling = { delayMs: 1000, idleTimeoutMs: 2000 };
  let pending: SwarmDeferredInstallation | null = null;

  function boot() {
    if (pending) return;
    const current = installSwarmDeferred(options, scheduling);
    pending = current;
    void current.ready.catch(error => {
      if (pending === current) pending = null;
      console.error('Swarm Protocol could not initialize.', error);
    });
  }

  function cleanup() {
    pending?.destroy();
    pending = null;
  }

  document.addEventListener('astro:before-swap', cleanup);
  document.addEventListener('astro:page-load', boot);
  boot();
</script>
