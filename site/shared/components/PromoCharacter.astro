---
// Deliberately simplified poster silhouettes. Gameplay and roster assets stay game-owned.
const {kind='bug',size=48,color='currentColor',left=false}=Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill={color} aria-hidden="true" class="promo-character" shape-rendering="crispEdges">
  <g transform={left?'translate(24 0) scale(-1 1)':undefined}>
    {kind==='frog' && <><path class="frog-jaw-open" d="M8 3h8v2h4v3h3v2h-5v2h-4v2h4v2h5v3h-3v2h-4v1H8v-1H5v-2H3v-3H2V9h1V6h2V4h3Z"/><path class="frog-jaw-closed" d="M8 3h8v2h4v3h3v5H13v2h10v4h-3v2h-4v1H8v-1H5v-2H3v-3H2V9h1V6h2V4h3Z"/><path d="M5 21h5v3H4v-2h1Zm11 0h4v1h2v2h-6Z"/><path d="M8 0h5v6H8Zm9 0h5v6h-5Z" fill="#fff5d7"/><path d="M11 1h2v3h-2Zm9 0h2v3h-2Z" fill="#152820"/></>}
    {kind==='ship' && <><path d="M9 1h2v7h2V1h2v7h2v5h3v4h2v5h-5v-3h-3v2h-4v-2H7v3H2v-5h2v-4h3V8h2Z"/><path d="M10 10h4v6h-4Z" fill="var(--surface)"/><path d="M11 12h2v2h-2Z" fill="#b5e66a"/><path d="M6 22h2v2H6Zm10 0h2v2h-2Z" fill="#fff5d7"/></>}
    {kind==='tank' && <><path d="M1 4h19v5H1Zm0 12h19v5H1Zm3-4h14v6H4Z"/><path d="M7 8h8v9H7Z" fill="var(--surface)"/><path d="M8 9h7v7H8Zm5 2h11v3H13Z"/></>}
    {kind==='bug' && <><path d="M7 0h2v3h6V0h2v3h-2v2h3v3h3V6h3v3h-3v2h-3v2h6v2h-6v2h3v2h3v3h-3v-3h-3v2h-3v2H9v-2H6v-2H3v3H0v-3h3v-2h3v-2H0v-2h6v-2H3V9H0V6h3v2h3V5h3V3H7Z"/><path d="M8 7h3v3H8Zm5 0h3v3h-3Zm-2 6h2v7h-2Z" fill="var(--surface)"/></>}
    {kind==='alien' && <><path d="M5 1h3v3h8V1h3v3h-3v3h5v3h3v9h-3v-5h-3v5h-3v2h6v3h-6v-3H9v3H3v-3h6v-2H6v-5H3v5H0v-9h3V7h5V4H5Z"/><path d="M6 9h4v4H6Zm8 0h4v4h-4Z" fill="var(--surface)"/></>}
  </g>
</svg>
